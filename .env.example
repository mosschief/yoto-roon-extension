# Copy to .env and fill in what you need.

# --- TIDAL (if provider = "tidal") ---
# Create an app at https://developer.tidal.com/dashboard
# Add the redirect URI below to the app's settings.
TIDAL_CLIENT_ID=
TIDAL_REDIRECT_URI=http://127.0.0.1:8976/callback

# --- Qobuz (if provider = "qobuz") ---
# Qobuz does not have an open developer signup; you need an app_id
# (and for some endpoints an app_secret) issued by Qobuz.
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
QOBUZ_USERNAME=
QOBUZ_PASSWORD=

# --- Spotify (read-only, used to mirror Aquarium Drunkard playlists) ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
