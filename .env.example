# Copy to .env and fill in what you need.

# --- TIDAL (if provider = "tidal") ---
# Create an app at https://developer.tidal.com/dashboard
# Add the redirect URI below to the app's settings.
TIDAL_CLIENT_ID=
TIDAL_REDIRECT_URI=http://127.0.0.1:8976/callback

# --- Qobuz (if provider = "qobuz") ---
# Only username + password are required; the app id is auto-discovered from
# Qobuz's web player. Set QOBUZ_APP_ID only to override that.
QOBUZ_USERNAME=
QOBUZ_PASSWORD=
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=

# --- Spotify (OPTIONAL - read-only, used to mirror Aquarium Drunkard playlists) ---
# Leave empty to read public playlists via the embed page with no account.
# For the official API, create an app at https://developer.spotify.com/dashboard
# (a free Spotify account is enough).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
